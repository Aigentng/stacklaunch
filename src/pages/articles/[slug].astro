---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const CATEGORY_LABEL: Record<string, string> = { blog: 'Blog', 'case-study': 'Case study' };

function formatDate(d: Date) {
  return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
}
---

<BaseLayout
  title={`${post.data.seoTitle || post.data.title}: StackLaunch`}
  description={post.data.seoDescription || post.data.excerpt}
  ogImage={post.data.coverImage}
  ogType="article"
>
  <div style="position:relative;background:#060810;overflow-x:clip">
    <div style="position:sticky;top:0;z-index:60">
      <SiteNav active="articles" />
    </div>

    <section style="position:relative;padding:104px clamp(20px,4vw,56px) 0;background-image:radial-gradient(rgba(255,255,255,.05) 1px, transparent 1px);background-size:24px 24px">
      <div style="position:absolute;top:0;left:0;right:0;height:440px;pointer-events:none;background:radial-gradient(110% 100% at 24% 6%, rgba(37,99,235,.2), rgba(6,8,16,0) 60%)"></div>
      <svg viewBox="0 0 1440 700" preserveAspectRatio="xMidYMid slice" style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none;opacity:.8" aria-hidden="true">
        <defs>
          <linearGradient id="postHeroa" x1="1" y1="0" x2="0" y2="0">
            <stop offset="0" stop-color="#3B82F6" stop-opacity=".44" /><stop offset="1" stop-color="#3B82F6" stop-opacity="0" />
          </linearGradient>
          <linearGradient id="postHerob" x1="1" y1="0" x2="0" y2="0">
            <stop offset="0" stop-color="#34D399" stop-opacity=".38" /><stop offset="1" stop-color="#34D399" stop-opacity="0" />
          </linearGradient>
        </defs>
        <g fill="none" stroke-width="1" stroke-dasharray="1800" stroke-dashoffset="1800" style="animation:drawin 2.1s cubic-bezier(.2,.8,.25,1) both">
          <g stroke="url(#postHeroa)">
            <line x1="1540" y1="322" x2="700" y2="-40" /><line x1="1540" y1="322" x2="700" y2="126" /><line x1="1540" y1="322" x2="680" y2="294" />
          </g>
          <g stroke="url(#postHerob)">
            <line x1="1540" y1="322" x2="680" y2="518" /><line x1="1540" y1="322" x2="740" y2="760" />
          </g>
        </g>
        <g stroke-width="1.6" fill="none" stroke-linecap="round" stroke-dasharray="90 1600">
          <line x1="1540" y1="322" x2="700" y2="126" stroke="#3B82F6" style="animation:travel 9s linear infinite" />
          <line x1="1540" y1="322" x2="680" y2="518" stroke="#34D399" style="animation:travel 11.5s linear infinite;animation-delay:-4.5s" />
        </g>
        <circle cx="1540" cy="322" r="3.2" fill="#34D399" style="animation:softPulse 3.3s ease-in-out infinite" />
      </svg>
      <div style="position:relative;max-width:840px;margin:0 auto">
        <a href="/articles" style="display:inline-flex;align-items:center;gap:8px;font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:0.16em;text-transform:uppercase;color:rgba(233,238,246,.64);text-decoration:none">&lsaquo; Back to articles</a>
        <div style="margin-top:22px;display:flex;align-items:center;gap:10px">
          <span style="font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:0.2em;text-transform:uppercase;color:#34D399">{CATEGORY_LABEL[post.data.category]}</span>
          <span style="color:rgba(233,238,246,.3)">·</span>
          <span style="font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:0.2em;text-transform:uppercase;color:rgba(233,238,246,.64)">{formatDate(post.data.date)}</span>
        </div>
        <h1 style="margin:22px 0 0;font-family:'Space Grotesk',sans-serif;font-weight:300;font-size:clamp(32px,5vw,58px);line-height:1.05;letter-spacing:-0.03em;color:#F2F5FA">{post.data.title}</h1>
        {post.data.tags.length > 0 && (
          <div style="margin-top:20px;display:flex;flex-wrap:wrap;gap:8px">
            {post.data.tags.map((tag) => (
              <span style="display:inline-flex;align-items:center;padding:6px 12px;border-radius:999px;border:1px solid rgba(255,255,255,.12);font-family:'JetBrains Mono',monospace;font-size:11px;color:rgba(233,238,246,.66)">{tag}</span>
            ))}
          </div>
        )}
      </div>
    </section>

    <section style="position:relative;padding:48px clamp(20px,4vw,56px) 0">
      <div style="max-width:840px;margin:0 auto">
        <img src={post.data.coverImage} alt="" style="width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:18px;border:1px solid rgba(255,255,255,.09);display:block" />
      </div>
    </section>

    <section style="position:relative;padding:48px clamp(20px,4vw,56px) 120px;border-top:1px solid rgba(255,255,255,.09);margin-top:48px">
      <div class="post-body" style="max-width:720px;margin:0 auto">
        <Content />
      </div>
      <div style="max-width:720px;margin:56px auto 0;padding-top:24px;border-top:1px solid rgba(255,255,255,.09)">
        <a href="/articles" style="display:inline-flex;align-items:center;gap:8px;font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:0.16em;text-transform:uppercase;color:#93B4FC;text-decoration:none">&lsaquo; Back to articles</a>
      </div>
    </section>

    <SiteFooter />
  </div>
</BaseLayout>

<style is:global>
  .post-body { font-size: 17px; line-height: 1.72; color: rgba(233, 238, 246, .78); }
  .post-body h2 { margin: 44px 0 18px; font-family: 'Space Grotesk', sans-serif; font-weight: 400; font-size: 28px; line-height: 1.25; letter-spacing: -0.02em; color: #F2F5FA; }
  .post-body h3 { margin: 36px 0 14px; font-family: 'Space Grotesk', sans-serif; font-weight: 400; font-size: 22px; line-height: 1.3; color: #F2F5FA; }
  .post-body p { margin: 0 0 20px; }
  .post-body a { color: #93B4FC; }
  .post-body a:hover { color: #6EE7B7; }
  .post-body ul, .post-body ol { margin: 0 0 20px; padding-left: 22px; }
  .post-body li { margin-bottom: 8px; }
  .post-body blockquote { margin: 32px 0; padding: 4px 0 4px 20px; border-left: 2px solid rgba(52, 211, 153, .5); color: rgba(233, 238, 246, .9); font-style: italic; }
  .post-body code { font-family: 'JetBrains Mono', monospace; font-size: 14px; background: rgba(255, 255, 255, .06); padding: 2px 6px; border-radius: 4px; }
  .post-body pre { margin: 24px 0; padding: 20px; border-radius: 12px; border: 1px solid rgba(255, 255, 255, .09); background: rgba(255, 255, 255, .02); overflow-x: auto; }
  .post-body pre code { background: none; padding: 0; }
  .post-body img { max-width: 100%; border-radius: 12px; margin: 24px 0; }
</style>
