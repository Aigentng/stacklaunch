---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getEntry } from 'astro:content';
import { splitAccent, splitDualAccent, lucideIcon } from '../lib/text';

const home = (await getEntry('homePage', 'home'))!.data;

const problemHeading = splitDualAccent(home.problem.heading, home.problem.accentPhraseA, home.problem.accentPhraseB);
const helpHeading = splitAccent(home.howWeHelp.heading, home.howWeHelp.accentPhrase);
const worksHeading = splitAccent(home.howItWorks.heading, home.howItWorks.accentPhrase);
const archHeading = splitAccent(home.architecture.heading, home.architecture.accentPhrase);
const indHeading = splitAccent(home.industries.heading, home.industries.accentPhrase);
const ctaHeading = splitAccent(home.closingCta.heading, home.closingCta.accentPhrase);

/** Purely decorative per-card accent (matches the hand-authored source design; not editable content). */
const architectureAccents: ('a' | 'b')[] = ['a', 'a', 'b', 'b', 'a', 'b'];

const CALENDLY_URL = 'https://calendly.com/michuk-dev/30min';
---

<BaseLayout title="StackLaunch — You build the app. We make it production-ready." description="StackLaunch runs the secure, scalable cloud backend behind your app. AWS, Kubernetes, CI/CD, monitoring and backups, without a DevOps hire.">
  <div style="position:relative;background:#060810;overflow-x:clip">
    <div style="position:sticky;top:0;z-index:60">
      <SiteNav active="home" />
    </div>

    <section style="position:relative;padding:112px clamp(20px,4vw,56px) 0;background-image:radial-gradient(rgba(255,255,255,.055) 1px, transparent 1px);background-size:24px 24px">
      <div style="position:absolute;top:0;right:0;bottom:0;width:min(72%,1180px);pointer-events:none;background-image:url('/images/hero-datahall.png');background-size:cover;background-position:right center;background-repeat:no-repeat"></div>
      <div style="position:absolute;inset:0;pointer-events:none;background:linear-gradient(90deg,#060810 0%,#060810 30%,rgba(6,8,16,.85) 48%,rgba(6,8,16,.35) 68%,rgba(6,8,16,.15) 100%)"></div>
      <div style="position:absolute;inset:0;pointer-events:none;background:linear-gradient(180deg,rgba(6,8,16,.55) 0%,rgba(6,8,16,0) 26%,rgba(6,8,16,.55) 88%,#060810 100%)"></div>
      <div style="position:absolute;top:0;left:0;right:0;height:520px;pointer-events:none;background:radial-gradient(110% 100% at 12% 14%, rgba(37,99,235,.22), rgba(6,8,16,0) 60%)"></div>
      <svg viewBox="0 0 1440 760" preserveAspectRatio="xMidYMid slice" style="position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;opacity:.9" aria-hidden="true">
        <defs>
          <linearGradient id="heroFan" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#3B82F6" stop-opacity=".5" />
            <stop offset="1" stop-color="#3B82F6" stop-opacity="0" />
          </linearGradient>
          <linearGradient id="heroFanB" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#34D399" stop-opacity=".42" />
            <stop offset="1" stop-color="#34D399" stop-opacity="0" />
          </linearGradient>
        </defs>
        <g fill="none" stroke-width="1" stroke-dasharray="1800" stroke-dashoffset="1800" style="animation:drawin 1.8s cubic-bezier(.2,.8,.25,1) both">
          <g stroke="url(#heroFan)">
            <line x1="-100" y1="300" x2="820" y2="-40" /><line x1="-100" y1="300" x2="820" y2="90" />
            <line x1="-100" y1="300" x2="840" y2="230" /><line x1="-100" y1="300" x2="840" y2="380" />
          </g>
          <g stroke="url(#heroFanB)">
            <line x1="-100" y1="300" x2="820" y2="520" /><line x1="-100" y1="300" x2="800" y2="660" />
            <line x1="-100" y1="300" x2="740" y2="780" />
          </g>
        </g>
        <g stroke-width="1.6" fill="none" stroke-linecap="round" stroke-dasharray="90 1600">
          <line x1="-100" y1="300" x2="820" y2="90" stroke="#3B82F6" style="animation:travel 7s linear infinite" />
          <line x1="-100" y1="300" x2="840" y2="380" stroke="#3B82F6" style="animation:travel 9.5s linear infinite;animation-delay:-3.4s" />
          <line x1="-100" y1="300" x2="820" y2="520" stroke="#34D399" style="animation:travel 8.5s linear infinite;animation-delay:-1.6s" />
          <line x1="-100" y1="300" x2="740" y2="780" stroke="#34D399" style="animation:travel 11s linear infinite;animation-delay:-6s" />
        </g>
        <circle cx="-100" cy="300" r="3.5" fill="#3B82F6" style="animation:softPulse 3.2s ease-in-out infinite" />
      </svg>
      <div style="position:relative;max-width:1320px;margin:0 auto">
        <div style="display:grid;grid-template-columns:1fr auto;gap:40px;align-items:end" data-stack>
          <div>
            <span style="display:inline-flex;align-items:center;gap:9px;font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:0.2em;text-transform:uppercase;color:rgba(233,238,246,.68)">
              <span style="display:block;width:6px;height:6px;border-radius:50%;background:#34D399;animation:softPulse 2.6s ease-in-out infinite"></span>
              {home.hero.eyebrow}
            </span>
            <h1 style="margin:26px 0 0;font-family:'Space Grotesk',sans-serif;font-weight:300;font-size:clamp(44px,7.6vw,116px);line-height:0.96;letter-spacing:-0.035em;color:#F2F5FA">{home.hero.headlineLine1}<br />{home.hero.headlineLead}<span style="color:#3B82F6">{home.hero.headlineAccentA}</span><span style="color:#34D399">{home.hero.headlineAccentB}</span></h1>
          </div>
          <div style="display:flex;flex-direction:column;align-items:flex-end;gap:18px;padding-bottom:10px" data-hide-mobile>
            <span style="font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:0.2em;text-transform:uppercase;color:rgba(233,238,246,.64);writing-mode:vertical-rl">scroll</span>
          </div>
        </div>

        <div style="margin-top:46px;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.05fr);gap:56px;align-items:end" data-stack>
          <p style="margin:0;max-width:520px;font-size:17px;line-height:1.66;color:rgba(233,238,246,.62)">{home.hero.body}</p>
          <div style="display:flex;gap:10px;flex-wrap:wrap">
            <a class="btn-primary" href={CALENDLY_URL} target="_blank" rel="noopener noreferrer" style="display:inline-flex;align-items:center;gap:10px;padding:12px 20px;border-radius:999px;background:#F2F5FA;color:#060810;font-size:14px;font-weight:500;text-decoration:none;transition:all 220ms cubic-bezier(.2,.8,.25,1)">{home.hero.primaryCtaLabel}<span style="font-family:'JetBrains Mono',monospace;font-size:13px">&rsaquo;</span></a>
            <a class="btn-secondary" href="#how-we-help" style="display:inline-flex;align-items:center;gap:10px;padding:12px 20px;border-radius:999px;border:1px solid rgba(255,255,255,.16);color:#F2F5FA;font-size:14px;text-decoration:none;transition:all 220ms cubic-bezier(.2,.8,.25,1)">{home.hero.secondaryCtaLabel}<span style="font-family:'JetBrains Mono',monospace;font-size:13px">&rsaquo;</span></a>
          </div>
        </div>

        <div style="margin-top:64px;padding-top:18px;border-top:1px solid rgba(255,255,255,.09);display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;padding-bottom:26px" data-cols-2>
          <span style="font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:0.18em;text-transform:uppercase;color:rgba(233,238,246,.66)">{home.hero.trustLeft}</span>
          <span style="font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:0.18em;text-transform:uppercase;color:rgba(233,238,246,.66);text-align:right">{home.hero.trustRight}</span>
        </div>
      </div>
    </section>

    <section style="position:relative;overflow:hidden;padding:104px clamp(20px,4vw,56px) 96px;border-top:1px solid rgba(255,255,255,.09)">
      <div style="position:absolute;left:0;bottom:0;width:min(78%,1120px);height:min(82%,700px);pointer-events:none;background-image:url('/images/problem-desk.png');background-size:cover;background-position:right bottom;background-repeat:no-repeat;transform:scaleX(-1);-webkit-mask-image:radial-gradient(135% 118% at 6% 100%, #000 34%, rgba(0,0,0,.45) 66%, transparent 88%);mask-image:radial-gradient(135% 118% at 6% 100%, #000 34%, rgba(0,0,0,.45) 66%, transparent 88%)"></div>
      <div style="position:absolute;inset:0;pointer-events:none;background:linear-gradient(180deg,#060810 0%,rgba(6,8,16,.9) 22%,rgba(6,8,16,.55) 52%,rgba(6,8,16,.35) 100%)"></div>
      <div style="position:absolute;inset:0;pointer-events:none;background:linear-gradient(270deg,#060810 0%,rgba(6,8,16,.6) 34%,rgba(6,8,16,0) 72%)"></div>
      <svg viewBox="0 0 1440 620" preserveAspectRatio="xMidYMid slice" style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none;opacity:.75" aria-hidden="true">
        <defs>
          <linearGradient id="clPa" x1="1" y1="0" x2="0" y2="0">
            <stop offset="0" stop-color="#3B82F6" stop-opacity=".42" /><stop offset="1" stop-color="#3B82F6" stop-opacity="0" />
          </linearGradient>
          <linearGradient id="clPb" x1="1" y1="0" x2="0" y2="0">
            <stop offset="0" stop-color="#34D399" stop-opacity=".36" /><stop offset="1" stop-color="#34D399" stop-opacity="0" />
          </linearGradient>
        </defs>
        <g fill="none" stroke-width="1" stroke-dasharray="1800" stroke-dashoffset="1800" style="animation:drawin 2s cubic-bezier(.2,.8,.25,1) both;animation-timeline:view();animation-range:entry 0% cover 34%">
          <g stroke="url(#clPa)"><line x1="1530" y1="300" x2="740" y2="-20" /><line x1="1530" y1="300" x2="740" y2="130" /><line x1="1530" y1="300" x2="760" y2="280" /></g>
          <g stroke="url(#clPb)"><line x1="1530" y1="300" x2="760" y2="450" /><line x1="1530" y1="300" x2="800" y2="620" /></g>
        </g>
        <g stroke-width="1.5" fill="none" stroke-linecap="round" stroke-dasharray="80 1600">
          <line x1="1530" y1="300" x2="740" y2="130" stroke="#3B82F6" style="animation:travel 9s linear infinite" />
          <line x1="1530" y1="300" x2="760" y2="450" stroke="#34D399" style="animation:travel 11s linear infinite;animation-delay:-4.5s" />
        </g>
        <circle cx="1530" cy="300" r="3" fill="#3B82F6" style="animation:softPulse 3.4s ease-in-out infinite" />
      </svg>
      <div style="position:relative;max-width:1320px;margin:0 auto;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.15fr);gap:64px;align-items:start" data-stack>
        <div style="animation:rise .8s cubic-bezier(.2,.8,.25,1) both;animation-timeline:view();animation-range:entry 4% cover 24%">
          <span style="font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:0.2em;text-transform:uppercase;color:rgba(233,238,246,.66)">{home.problem.eyebrow}</span>
          <h2 style="margin:24px 0 0;font-family:'Space Grotesk',sans-serif;font-weight:300;font-size:clamp(32px,4.2vw,60px);line-height:1.02;letter-spacing:-0.03em;color:#F2F5FA">{problemHeading.before}<span style="color:#3B82F6">{problemHeading.accentA}</span>{problemHeading.middle}<span style="color:#34D399">{problemHeading.accentB}</span>{problemHeading.after}</h2>
          <p style="margin:26px 0 0;max-width:420px;font-size:16.5px;line-height:1.66">{home.problem.intro}</p>
        </div>
        <div>
          {home.problem.items.map((p) => (
            <div class="problem-row" style="display:grid;grid-template-columns:44px minmax(0,1fr) minmax(0,1fr);gap:20px;padding:26px 0;border-top:1px solid rgba(255,255,255,.09);align-items:baseline;transition:background 240ms ease" data-stack>
              <span style="font-family:'JetBrains Mono',monospace;font-size:11px;color:rgba(233,238,246,.64)">{p.n}</span>
              <span style="font-size:19px;line-height:1.35;color:#F2F5FA;font-weight:400">{p.a}</span>
              <span style="font-size:15.5px;line-height:1.55;color:rgba(233,238,246,.66)">{p.b}</span>
            </div>
          ))}
          <p style="margin:34px 0 0;max-width:560px;font-size:16.5px;line-height:1.66;padding-top:26px;border-top:1px solid rgba(255,255,255,.09)">{home.problem.closing}</p>
        </div>
      </div>
    </section>

    <section id="how-we-help" style="position:relative;overflow:hidden;padding:88px clamp(20px,4vw,56px) 92px;background:#0A0D16;border-top:1px solid rgba(255,255,255,.09)">
      <svg viewBox="0 0 1440 620" preserveAspectRatio="xMidYMid slice" style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none;opacity:.75" aria-hidden="true">
        <defs>
          <linearGradient id="clHa" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#3B82F6" stop-opacity=".42" /><stop offset="1" stop-color="#3B82F6" stop-opacity="0" />
          </linearGradient>
          <linearGradient id="clHb" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#34D399" stop-opacity=".36" /><stop offset="1" stop-color="#34D399" stop-opacity="0" />
          </linearGradient>
        </defs>
        <g fill="none" stroke-width="1" stroke-dasharray="1800" stroke-dashoffset="1800" style="animation:drawin 2s cubic-bezier(.2,.8,.25,1) both;animation-timeline:view();animation-range:entry 0% cover 34%">
          <g stroke="url(#clHa)"><line x1="-90" y1="310" x2="700" y2="-20" /><line x1="-90" y1="310" x2="700" y2="120" /><line x1="-90" y1="310" x2="680" y2="270" /></g>
          <g stroke="url(#clHb)"><line x1="-90" y1="310" x2="680" y2="450" /><line x1="-90" y1="310" x2="720" y2="620" /></g>
        </g>
        <g stroke-width="1.5" fill="none" stroke-linecap="round" stroke-dasharray="80 1600">
          <line x1="-90" y1="310" x2="700" y2="120" stroke="#3B82F6" style="animation:travel 9s linear infinite" />
          <line x1="-90" y1="310" x2="680" y2="450" stroke="#34D399" style="animation:travel 11s linear infinite;animation-delay:-4.5s" />
        </g>
        <circle cx="-90" cy="310" r="3" fill="#3B82F6" style="animation:softPulse 3.4s ease-in-out infinite" />
      </svg>
      <div style="position:relative;max-width:1320px;margin:0 auto">
        <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:32px;flex-wrap:wrap;margin-bottom:40px">
          <div>
            <span style="font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:0.2em;text-transform:uppercase;color:rgba(233,238,246,.66)">{home.howWeHelp.eyebrow}</span>
            <h2 style="margin:24px 0 0;max-width:760px;font-family:'Space Grotesk',sans-serif;font-weight:300;font-size:clamp(30px,3.8vw,54px);line-height:1.04;letter-spacing:-0.03em;color:#F2F5FA">{helpHeading.before}<span style="color:#3B82F6">{helpHeading.accent}</span>{helpHeading.after}</h2>
          </div>
          <span style="font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:0.18em;text-transform:uppercase;color:rgba(233,238,246,.64)">{home.howWeHelp.panelsLabel}</span>
        </div>
        <div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;align-items:stretch" data-stack>

          <article class="help-card" style="position:relative;padding:26px;border-radius:18px;border:1px solid rgba(255,255,255,.09);background:linear-gradient(180deg,rgba(255,255,255,.035),rgba(255,255,255,.012));display:flex;flex-direction:column;gap:18px;transition:border-color 240ms ease">
            <div style="display:flex;justify-content:space-between;align-items:center">
              <span style="font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:0.16em;color:rgba(233,238,246,.64)">001 / reliability</span>
              <span style="display:inline-flex;align-items:center;gap:7px;font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:0.16em;text-transform:uppercase;color:#34D399"><span style="display:block;width:6px;height:6px;border-radius:50%;background:#34D399;animation:softPulse 2.4s ease-in-out infinite"></span>healthy</span>
            </div>
            <h3 style="margin:0;font-family:'Space Grotesk',sans-serif;font-weight:400;font-size:24px;line-height:1.15;letter-spacing:-0.02em;color:#F2F5FA">{home.howWeHelp.reliabilityTitle}</h3>
            <svg viewBox="0 0 320 92" preserveAspectRatio="none" style="width:100%;flex:1;min-height:120px;height:auto;display:block" aria-hidden="true">
              <path d="M0 74 L26 66 L52 78 L78 50 L104 62 L130 40 L156 54 L182 30 L208 42 L234 22 L260 34 L286 14 L320 24" fill="none" stroke="#3B82F6" stroke-width="1.6" stroke-dasharray="600" stroke-dashoffset="600" style="animation:dash600 1.6s cubic-bezier(.2,.8,.25,1) both;animation-timeline:view();animation-range:entry 6% cover 30%" />
              <path d="M0 84 L26 86 L52 80 L78 84 L104 76 L130 82 L156 72 L182 78 L208 68 L234 76 L260 66 L286 72 L320 62" fill="none" stroke="rgba(52,211,153,.75)" stroke-width="1.4" stroke-dasharray="600" stroke-dashoffset="600" style="animation:dash600 2s cubic-bezier(.2,.8,.25,1) both;animation-timeline:view();animation-range:entry 6% cover 34%" />
              <path d="M0 74 L26 66 L52 78 L78 50 L104 62 L130 40 L156 54 L182 30 L208 42 L234 22 L260 34 L286 14 L320 24" fill="none" stroke="#DCE9FF" stroke-width="2" stroke-linecap="round" stroke-dasharray="26 660" style="animation:runDash 4.6s linear infinite" />
              <circle cx="286" cy="14" r="3" fill="#3B82F6" style="transform-box:fill-box;transform-origin:center;animation:blipIn 1.4s cubic-bezier(.2,.8,.25,1) both;animation-timeline:view();animation-range:entry 12% cover 34%" />
            </svg>
            <p style="margin:auto 0 0;padding-top:18px;border-top:1px solid rgba(255,255,255,.09);font-size:15px;line-height:1.6;color:rgba(233,238,246,.66)">{home.howWeHelp.reliabilityBody}</p>
          </article>

          <article class="help-card" style="position:relative;padding:26px;border-radius:18px;border:1px solid rgba(255,255,255,.09);background:linear-gradient(180deg,rgba(255,255,255,.035),rgba(255,255,255,.012));display:flex;flex-direction:column;gap:18px;transition:border-color 240ms ease">
            <div style="display:flex;justify-content:space-between;align-items:center">
              <span style="font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:0.16em;color:rgba(233,238,246,.64)">002 / reach</span>
              <span style="font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:0.16em;text-transform:uppercase;color:rgba(233,238,246,.64)">3 regions</span>
            </div>
            <h3 style="margin:0;font-family:'Space Grotesk',sans-serif;font-weight:400;font-size:24px;line-height:1.15;letter-spacing:-0.02em;color:#F2F5FA">{home.howWeHelp.reachTitle}</h3>
            <svg viewBox="0 0 300 150" preserveAspectRatio="xMidYMid meet" style="width:100%;flex:1;min-height:120px;height:auto;display:block" aria-hidden="true">
              <g fill="none" stroke="rgba(255,255,255,.14)" stroke-width="1" stroke-dasharray="600" stroke-dashoffset="600" style="animation:dash600 1.8s cubic-bezier(.2,.8,.25,1) both;animation-timeline:view();animation-range:entry 6% cover 32%">
                <path d="M150 140 A 110 110 0 0 1 40 30" /><path d="M150 140 A 84 84 0 0 1 66 56" /><path d="M150 140 A 58 58 0 0 1 92 82" /><path d="M150 140 A 32 32 0 0 1 118 108" />
              </g>
              <path d="M150 140 A 84 84 0 0 1 66 56" fill="none" stroke="#34D399" stroke-width="1.8" stroke-linecap="round" stroke-dasharray="22 600" style="animation:runDash 5.2s linear infinite" />
              <path d="M150 140 A 110 110 0 0 1 40 30" fill="none" stroke="#3B82F6" stroke-width="1.6" stroke-linecap="round" stroke-dasharray="18 600" style="animation:runDash 7s linear infinite;animation-delay:-2.4s" />
              <circle cx="150" cy="140" r="4" fill="#3B82F6" style="animation:softPulse 2.6s ease-in-out infinite" />
              <circle cx="118" cy="108" r="2.4" fill="#93B4FC" style="animation:relay 5.2s ease-in-out infinite" />
              <circle cx="92" cy="82" r="2.6" fill="#93B4FC" style="animation:relay 5.2s ease-in-out infinite;animation-delay:.5s" />
              <circle cx="66" cy="56" r="3" fill="#34D399" style="animation:relay 5.2s ease-in-out infinite;animation-delay:1s" />
              <circle cx="40" cy="30" r="2.6" fill="#34D399" style="animation:relay 5.2s ease-in-out infinite;animation-delay:1.5s" />
            </svg>
            <p style="margin:auto 0 0;padding-top:18px;border-top:1px solid rgba(255,255,255,.09);font-size:15px;line-height:1.6;color:rgba(233,238,246,.66)">{home.howWeHelp.reachBody}</p>
          </article>

          <article class="help-card" style="position:relative;padding:26px;border-radius:18px;border:1px solid rgba(255,255,255,.09);background:linear-gradient(180deg,rgba(255,255,255,.035),rgba(255,255,255,.012));display:flex;flex-direction:column;gap:18px;transition:border-color 240ms ease">
            <div style="display:flex;justify-content:space-between;align-items:center">
              <span style="font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:0.16em;color:rgba(233,238,246,.64)">003 / automation</span>
              <span style="font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:0.16em;text-transform:uppercase;color:#34D399">passing</span>
            </div>
            <h3 style="margin:0;font-family:'Space Grotesk',sans-serif;font-weight:400;font-size:24px;line-height:1.15;letter-spacing:-0.02em;color:#F2F5FA">{home.howWeHelp.automationTitle}</h3>
            <svg viewBox="0 0 300 150" preserveAspectRatio="xMidYMid meet" style="width:100%;flex:1;min-height:120px;height:auto;display:block" aria-hidden="true">
              <g transform="translate(150,75)">
                <g style="animation:spinSlow 48s linear infinite">
                  <g fill="none" stroke="rgba(255,255,255,.13)" stroke-width="1" transform="rotate(-16)">
                    <ellipse rx="120" ry="42" /><ellipse rx="86" ry="30" /><ellipse rx="52" ry="18" />
                  </g>
                  <g transform="rotate(-16)">
